# SurakshaEdge — Environment Variables Reference
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── API Security ────────────────────────────────────────────────────────────
# Bearer token required for POST /events, POST /simulate, PATCH /cameras/{id}/status
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SURAKSHA_API_TOKEN=change-me-to-a-strong-secret

# AES-256-GCM key for clip encryption (auto-generated by Render if not set)
# 32-byte hex string — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SURAKSHA_KEY=

# ── Runtime Mode ────────────────────────────────────────────────────────────
# Set to "true" in production to disable /simulate endpoint
SURAKSHA_PRODUCTION=false

# Audio mode: "mfcc_cnn" (with trained model) or "energy_fallback" (default)
SURAKSHA_AUDIO_MODE=energy_fallback

# ── Config & Persistence ────────────────────────────────────────────────────
# Path to camera/pipeline config YAML
SURAKSHA_CONFIG=configs/demo.yaml

# SQLite DB path for event persistence (use :memory: for ephemeral/test)
SURAKSHA_DB=results/events.db

# ── Server ──────────────────────────────────────────────────────────────────
# Port uvicorn listens on (Render sets this automatically)
PORT=8000

# ── Testing ─────────────────────────────────────────────────────────────────
# Set to "1" during pytest to skip background tasks (avoids event-loop conflicts)
SURAKSHA_TEST_MODE=

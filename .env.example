# SurakshaEdge — Environment Variables
# Copy this file to .env and fill in real values before starting locally.
# On Railway, set these in the project's "Variables" panel.

# Secret key used to sign/verify API tokens (32 bytes, base64-encoded).
# Generate a fresh one with:
#   python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
SURAKSHA_KEY=<generate with: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())">

# Bearer token that edge nodes must supply in the Authorization header.
SURAKSHA_API_TOKEN=demo-token

# Set to "true" to disable the /simulate endpoint in production.
SURAKSHA_PRODUCTION=false

# Path to camera config (relative to the working directory).
# SURAKSHA_CONFIG=configs/demo.yaml

# Audio inference mode override (set automatically at startup from config).
# SURAKSHA_AUDIO_MODE=energy_fallback
